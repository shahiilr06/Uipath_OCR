rExpressions.Match = System.Text.RegularExpressions.Regex.Match(output, &quot;\b[A-Z]{5}[0-9]{4}[A-Z]\b&quot;)&#xA;    If mDoc.Success Then out_DocNumber = mDoc.Value&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(out_DOB) OrElse String.IsNullOrWhiteSpace(out_IssueDate) Then&#xA;    Dim dateMatches As System.Text.RegularExpressions.MatchCollection = System.Text.RegularExpressions.Regex.Matches(output, &quot;\b(\d{2})[1/I|l\.\-](\d{2})[1/I|l\.\-](\d{4})\b&quot;)&#xA;    If dateMatches.Count &gt;= 1 AndAlso String.IsNullOrWhiteSpace(out_DOB) Then&#xA;        out_DOB = formatOcrDate(dateMatches(0).Value)&#xA;    End If&#xA;    If dateMatches.Count &gt;= 2 AndAlso String.IsNullOrWhiteSpace(out_IssueDate) Then&#xA;        out_IssueDate = formatOcrDate(dateMatches(1).Value)&#xA;    End If&#xA;End If">
